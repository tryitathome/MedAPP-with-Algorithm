FRONTEND_URL=http://localhost:3000
PORT=5050

# Backward-compatible defaults:
# NO_DB=true forces in-memory persistence regardless of DATA_BACKEND.
NO_DB=true
DATA_BACKEND=mongodb
STORAGE_BACKEND=local
MONGODB_URI=mongodb://localhost:27017/medical-imaging

# Server-only Supabase settings. Never prefix the secret with NEXT_PUBLIC_.
# DATA_BACKEND=supabase
# STORAGE_BACKEND=supabase
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_your_server_only_key
# Legacy projects may use SUPABASE_SERVICE_ROLE_KEY instead.
# SUPABASE_STORAGE_BUCKET=oral-images
# SUPABASE_SIGNED_URL_TTL_SECONDS=300

# Existing Python/AI configuration remains unchanged.
PYTHON_EXE_PATH=python
CLASSIFY_TIMEOUT_MS=180000
YOLO_PYTHON_EXE_PATH=python
MMDET_PYTHON_EXE_PATH=python
MMDET_DEVICE=cuda:0
MMDET_TIMEOUT_MS=600000
